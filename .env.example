# Replace the value below with your actual OpenAI API key.
# Do not put quotes around the key.
OPENAI_API_KEY=sk-your-api-key-here

# --- LangSmith Tracing ---
# Off by default. Set to "true" to send a trace of every question, tool call and answer to
# LangSmith; that includes what your colleagues type into the chat. While it is "false"
# the @traceable decorators do nothing. The evals trace their own runs whatever this says;
# they only need the key below.
LANGCHAIN_TRACING_V2=false
# Get a key from https://smith.langchain.com -> Settings -> API Keys
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key-here
# Traces are grouped under this project name in the LangSmith UI.
LANGCHAIN_PROJECT=geospatial-qa-agent
# Use https://eu.api.smith.langchain.com if your workspace is in the EU region.
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Models ---
# Optional. Both default to gpt-4o-mini. The vision model looks at the tile or the cell;
# judging whether a thin trail is visible is the hardest job here, so it is the one to
# try a stronger model on first.
AGENT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
